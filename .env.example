# KRAFTSTOFF – optionale Umgebungsvariablen
# Normalerweise ist nichts davon nötig: Den Tankerkönig-Key trägst du in der App ein,
# er wird in deinem iCloud-Datenbank-Ordner gesichert.

# Serverseitiger Ersatz-Key für den Proxy /api/tankerkoenig (Vercel: Settings → Environment Variables).
# Wird nur benutzt, wenn die App selbst keinen Key mitschickt. Achtung: Wer die Adresse deiner App kennt,
# kann dann über diesen Key Preise abfragen.
# TANKERKOENIG_API_KEY=dein-api-key-hier

# Nur für die lokale Entwicklung: Key fest in die App einbauen.
# VITE_-Variablen landen im ausgelieferten JavaScript und sind damit öffentlich lesbar.
# Auf Vercel deshalb NICHT setzen.
# VITE_TANKERKOENIG_KEY=dein-api-key-hier
